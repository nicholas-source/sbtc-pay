VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Network: testnet or mainnet
VITE_NETWORK_MODE=testnet

# Payment contract (defaults to testnet deployer if omitted)
# VITE_PAYMENT_CONTRACT_ADDRESS=STR54P37AA27XHMMTCDEW4YZFPFJX69160WQESWR
# VITE_PAYMENT_CONTRACT_NAME=payment-v4

# Optional overrides (auto-derived from VITE_NETWORK_MODE if omitted)
# VITE_STACKS_API_URL=https://api.testnet.hiro.so

# Hiro API key. Optional: without it, calls fall back to anonymous rate
# limits, which is fine in dev but tight in production. Free from Hiro as
# of 2026-10-30. Get one at platform.hiro.so (API Hub).
# Sent as the x-api-key header - NOT the legacy x-hiro-api-key/x-partner
# headers, which stop granting authenticated limits after 2026-10-30.
# Like VITE_SUPABASE_ANON_KEY this ships in the browser bundle, so it is
# an identifier rather than a credential - but keep the real value in
# .env / the Vercel dashboard, never here.
# VITE_STACKS_API_KEY=your_hiro_api_key_here
# VITE_EXPLORER_URL=https://explorer.hiro.so/?chain=testnet
